#!/bin/sh
set -e

# fss-adsb parses attacker-reachable RF-derived data (SBS-1 lines relayed
# from dump1090) while holding FSS client TLS private keys, so it must not
# run as root. A dedicated system user owns nothing dynamic (no DynamicUser:
# the TLS private-key files are persistent and need a stable owner) -- see
# fss-adsb@.service's [Service] hardening and debian/fss-adsb.conf.example
# for the certificate ownership this user needs.
#
# UID/GID 963 is pinned explicitly rather than left to adduser's free-id
# pick, and must stay identical to docker/Dockerfile's addgroup/adduser
# calls: an operator bind-mounting the same /certs directory into both a
# systemd-run instance and a container needs matching ownership on both
# sides. The number itself is arbitrary (just clear of this distro's
# default system-id allocations) -- only the "same in both files" part
# matters. Risk: 963 could already be taken by another package on some
# target system, in which case addgroup/adduser below fails loudly at
# install time rather than silently reusing the wrong id.
if [ "$1" = "configure" ]; then
    addgroup --system --gid 963 --quiet fss-adsb
    adduser --system --uid 963 --ingroup fss-adsb --quiet \
        --no-create-home --home /nonexistent fss-adsb
fi

#DEBHELPER#

exit 0
